{
  "manifest_version": 2,
  "name": "Zen Minimal Ad Blocker",
  "version": "0.2",
  "description": "Minimal educational ad blocker for Zen",
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "alarms",
    "tabs",
    "activeTab"
  ],
  "background": {
    "scripts": ["lib/browser-polyfill.js", "shared/settings.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["lib/browser-polyfill.js", "content/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["lib/browser-polyfill.js", "content/general.js"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Zen Ad Blocker",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
